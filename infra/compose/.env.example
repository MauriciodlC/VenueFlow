# Copy to .env and replace the placeholder values. .env is ignored by git.
POSTGRES_DB=venueflow
POSTGRES_USER=venueflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
# Password for every seeded demo account (at least 12 characters). Only used by
# `scripts/dev.sh setup` when it creates the accounts; never reused elsewhere.
DEMO_PASSWORD=change-me-demo-password
